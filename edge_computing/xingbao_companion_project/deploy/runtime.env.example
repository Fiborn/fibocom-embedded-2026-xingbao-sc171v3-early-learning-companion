# Local-only IPC endpoints shared by the unified arm and six-point vision services.
# Copy these non-secret values to /home/fibo/.config/xingbao/runtime.env on the board.
## Streaming ASR backend: `cloud` uses the shared DASHSCOPE_API_KEY and
## qwen-audio-3.0-asr-flash-streaming; `local` uses bundled Sherpa-ONNX.
XINGBAO_ASR_BACKEND=cloud
XINGBAO_ARM_ACTION_HOST=127.0.0.1
XINGBAO_ARM_ACTION_PORT=8764
XINGBAO_HAND_RECOGNITION_CONTROL_HOST=127.0.0.1
XINGBAO_HAND_RECOGNITION_CONTROL_PORT=10001
XINGBAO_VISION_POINT_ACTION_HOST=127.0.0.1
XINGBAO_VISION_POINT_ACTION_PORT=10000
