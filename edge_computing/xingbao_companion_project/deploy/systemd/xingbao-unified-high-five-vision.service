[Unit]
Description=Xingbao unified local six-point high-five vision runtime
After=xingbao-camera.service xingbao-unified-arm.service
Wants=xingbao-camera.service xingbao-unified-arm.service
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/fibo/xingbao_companion_unified
Environment=HOME=/home/fibo
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/fibo/.config/xingbao/runtime.env
ExecStart=/home/fibo/miniforge3/bin/python3 -m multimodal.high_five_vision_runtime --source http://127.0.0.1:4445/?action=stream
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=default.target graphical-session.target
